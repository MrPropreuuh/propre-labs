# Copy to .env and fill in the values below.
# The Cloudflare tunnel is configured by ~/.cloudflared/config.yml on the Pi
# (see cloudflared-config.yml), not by an environment variable.

# Marvel Rivals API (used server-side by the fetcher — never shipped to the browser)
MARVEL_API_KEY=your_marvelrivalsapi_key_here
MARVEL_PLAYER=MrPropreter

# How often the Pi re-fetches the API, in seconds (default 300 = every 5 min)
FETCH_INTERVAL_SECONDS=300

# Season label shown on the site (the API only exposes an internal id, not the
# marketing name). e.g. "Season 3", "Season 3.5", or leave generic.
SEASON_LABEL=Current Season
